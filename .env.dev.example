# Kafka - Dev Environment
# 로컬 개발: KAFKA_ADVERTISED_HOST=localhost
# dev EC2: KAFKA_ADVERTISED_HOST=<EC2_PUBLIC_IP>
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8080
# 최초 1회 생성 후 절대 변경 금지
# 생성 방법: docker run --rm apache/kafka:latest /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=<GENERATE_CLUSTER_ID>
